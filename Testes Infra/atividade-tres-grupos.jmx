      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Configuracao - Validar antes de acessar o ALB" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
def erros = []
if (!(vars.get(&apos;host&apos;) ==~ /[a-zA-Z0-9][a-zA-Z0-9.-]*/)) {
    erros.add(&apos;Informe -Jhost com o DNS do ALB, sem protocolo, porta ou caminho.&apos;)
}
if (!(vars.get(&apos;protocolo&apos;) in [&apos;http&apos;, &apos;https&apos;])) erros.add(&apos;Protocolo deve ser http ou https.&apos;)
if (!vars.get(&apos;email&apos;)?.trim()) erros.add(&apos;Informe -Jemail com uma conta de teste ativa.&apos;)
if (!System.getenv(&apos;JMETER_PASSWORD&apos;)) erros.add(&apos;Defina a variavel de ambiente JMETER_PASSWORD.&apos;)
def grupo = props.getProperty(&apos;grupo&apos;, &apos;todos&apos;)
if (!(grupo in [&apos;todos&apos;, &apos;2&apos;, &apos;20&apos;, &apos;100&apos;])) erros.add(&apos;grupo deve ser todos, 2, 20 ou 100.&apos;)
if (!(props.getProperty('navegacao', 'diferentes') in ['mesmo', 'diferentes'])) erros.add('navegacao deve ser mesmo ou diferentes.')
if (!(props.getProperty('tela', 'pecas') in ['dashboard', 'pecas', 'periodos', 'pedidos'])) erros.add('tela deve ser dashboard, pecas, periodos ou pedidos.')
def limites = [
    porta: [80, 1, 65535], duracao_s: [300, 2, 86400],
    rampa_2_s: [2, 1, 86399], rampa_20_s: [20, 1, 86399], rampa_100_s: [60, 1, 86399],
    pausa_ms: [500, 0, 60000], variacao_ms: [500, 0, 60000],
    limite_resposta_ms: [5000, 1, 600000],
    timeout_conexao_ms: [5000, 1, 600000], timeout_resposta_ms: [10000, 1, 600000]
]
def valores = [:]
limites.each { chave, faixa -&gt;
    def texto = props.getProperty(chave, faixa[0].toString())
    if (!(texto ==~ /[0-9]{1,9}/) || texto.toLong() &lt; faixa[1] || texto.toLong() &gt; faixa[2]) {
        erros.add(&quot;Parametro ${chave} deve ser inteiro entre ${faixa[1]} e ${faixa[2]}.&quot;)
    } else {
        valores[chave] = texto.toInteger()
    }
}
[&apos;2&apos;, &apos;20&apos;, &apos;100&apos;].each { n -&gt;
    if (grupo in [&apos;todos&apos;, n] &amp;&amp; valores.duracao_s != null &amp;&amp;
            valores[&quot;rampa_${n}_s&quot;.toString()] != null &amp;&amp;
            valores.duracao_s &lt;= valores[&quot;rampa_${n}_s&quot;.toString()]) {
        erros.add(&quot;duracao_s deve ser maior que rampa_${n}_s.&quot;)
    }
}
if (erros) {
    def mensagem = erros.join(&apos; &apos;)
    log.error(mensagem)
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;CONFIG&apos;)
    SampleResult.setResponseMessage(mensagem)
    SampleResult.setStopTestNow(true)
    return
}
[&apos;2&apos;, &apos;20&apos;, &apos;100&apos;].each { n -&gt; props.setProperty(&apos;exec.usuarios_&apos; + n, grupo in [&apos;todos&apos;, n] ? n : &apos;0&apos;) }
SampleResult.setResponseCode(&apos;200&apos;)
SampleResult.setResponseMessage(&apos;Parametros validos; nenhuma requisicao externa nesta etapa.&apos;)
SampleResult.setSuccessful(true)
</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
