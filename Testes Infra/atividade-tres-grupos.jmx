        <CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="Sessao isolada por usuario virtual" enabled="true">
          <collectionProp name="CookieManager.cookies"/>
          <boolProp name="CookieManager.clearEachIteration">false</boolProp>
