      <TestFragmentController guiclass="TestFragmentControllerGui" testclass="TestFragmentController" testname="Fluxo compartilhado - API pelo ALB" enabled="true">
        <stringProp name="TestPlan.comments">Mesmo fluxo nos tres grupos; cada thread mantem seu proprio cookie. Nao executa como grupo independente.</stringProp>
      </TestFragmentController>
