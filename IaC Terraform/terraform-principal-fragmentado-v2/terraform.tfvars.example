aws_region       = "us-east-1"
environment_name = "lamar-auto-pecas"
instance_type    = "t3.micro"

# Confirme o nome com:
# aws iam list-instance-profiles-for-role --role-name LabRole --query "InstanceProfiles[].InstanceProfileName" --output text
instance_profile_name = "LabInstanceProfile"

# Deixe vazio para não criar assinatura SNS ou informe um e-mail real.
alert_email = ""
